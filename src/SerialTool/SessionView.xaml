<UserControl x:Class="SerialTool.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="clr-namespace:SerialTool.Features">
    <Grid Margin="4,6,4,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：本会话的连接 / 显示 / 统计 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="连接设置（本会话）" Style="{StaticResource CardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="类型" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ConnTypeCombo" Grid.Column="1" SelectionChanged="ConnTypeCombo_SelectionChanged"/>
                        </Grid>
                        <StackPanel x:Name="SerialPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="端口" Style="{StaticResource FieldLabel}"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortCombo" IsEditable="True" IsTextSearchEnabled="False"/>
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource SmallButton}" Margin="4,3,0,3" Click="RefreshPorts_Click"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="波特率" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="BaudCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False"/>
                                <TextBlock Grid.Row="2" Text="数据位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DataBitsCombo" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Text="停止位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="StopBitsCombo" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Text="校验位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ParityCombo" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Text="流控" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="FlowCombo" Grid.Row="5" Grid.Column="1"/>
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <CheckBox x:Name="DtrChk" Content="DTR"/>
                                <CheckBox x:Name="RtsChk" Content="RTS"/>
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel x:Name="NetPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="HostLabel" Text="远程地址" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="HostBox" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock x:Name="RemotePortLabel" Grid.Row="1" Text="远程端口" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RemotePortBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock x:Name="LocalPortLabel" Grid.Row="2" Text="本地端口" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LocalPortBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="OpenBtn" Content="打开" Style="{StaticResource AccentButton}" Height="34" Margin="0,8,0,0" Click="OpenBtn_Click"/>
                        <TextBlock x:Name="ConnStateText" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="未连接"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="接收设置" Style="{StaticResource CardTitle}"/>
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="HexDisplayChk" Content="HEX 显示" Click="DisplayOption_Click"/>
                            <CheckBox x:Name="TimestampChk" Content="时间戳" Click="DisplayOption_Click"/>
                            <CheckBox x:Name="ShowTxChk" Content="显示发送" Click="DisplayOption_Click"/>
                            <CheckBox x:Name="AutoScrollChk" Content="自动滚动" IsChecked="True"/>
                            <CheckBox x:Name="PauseChk" Content="暂停显示"/>
                            <CheckBox x:Name="AutoReplyChk" Content="自动回复" ToolTip="使用“高亮 / 自动回复规则”（全局规则）在本会话上自动回复"/>
                        </UniformGrid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="编码" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EncodingCombo" Grid.Column="1" SelectionChanged="EncodingCombo_SelectionChanged"/>
                            <TextBlock Grid.Row="1" Text="协议" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ProtocolCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="ProtocolCombo_SelectionChanged"/>
                            <TextBlock Grid.Row="2" Text="断帧 ms" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FrameGapBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" LostFocus="DisplayOption_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="统计 / 录制" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="CountText" FontFamily="{StaticResource MonoFont}" Text="RX: 0   TX: 0"/>
                        <TextBlock x:Name="ReplyCountText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="计数清零" Margin="0,0,3,0" Click="ResetCounters_Click"/>
                            <Button x:Name="RecordBtn" Content="开始录制…" Margin="3,0,0,0" Click="RecordBtn_Click"
                                    ToolTip="把本会话的收发录制为 .stsession 文件，可在“扩展工具 → 录制回放”里回放"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧：接收 / 脚本 + 发送区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="210" MinHeight="150"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0" Padding="0" Background="{DynamicResource RxBgBrush}">
                <TabControl x:Name="ViewTabs" Background="{DynamicResource RxBgBrush}" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource ThemedTabItem}"/>
                    </TabControl.Resources>
                    <TabItem Header="接收">
                        <Grid Background="{DynamicResource RxBgBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="12,4">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="保存…" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="SaveRx_Click"/>
                                        <Button Content="清空" Style="{StaticResource PanelButton}" Click="ClearRx_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RxTitle" Text="接收区" Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <TextBox x:Name="RxBox" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Background="{DynamicResource RxBgBrush}" Foreground="{DynamicResource RxFgBrush}"
                                     SelectionBrush="{DynamicResource RxSelectionBrush}" BorderThickness="0" Padding="8,6"
                                     FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                                     IsUndoEnabled="False" UndoLimit="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                            <ListBox x:Name="LineList" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource RxBgBrush}"
                                     BorderThickness="0" Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <f:ColoredLineBlock Line="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="脚本">
                        <Grid Background="{DynamicResource RxBgBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="80"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="120" MinHeight="60"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <ComboBox x:Name="ScriptSampleCombo" Width="150" Height="24" Margin="0,0,6,0" SelectionChanged="ScriptSample_Changed"/>
                                        <Button x:Name="ScriptRunBtn" Content="运行" Style="{StaticResource AccentButton}" Padding="14,2" Margin="0,0,6,0" Click="ScriptRun_Click"/>
                                        <Button x:Name="ScriptStopBtn" Content="停止" Style="{StaticResource DangerButton}" Padding="14,2" IsEnabled="False" Click="ScriptStop_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="脚本类型" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ScriptLangCombo" Width="80" Height="24" Margin="0" SelectionChanged="ScriptLang_Changed"/>
                                        <TextBlock x:Name="ScriptStatusText" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBox x:Name="ScriptBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                     FontFamily="{StaticResource MonoFont}" FontSize="13" Background="{DynamicResource RxBgBrush}"
                                     Foreground="{DynamicResource RxFgBrush}" BorderThickness="0" Padding="8"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>
                            <TextBox x:Name="ScriptOutBox" Grid.Row="3" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Background="{DynamicResource ScriptOutBgBrush}" Foreground="{DynamicResource ScriptOutFgBrush}"
                                     BorderThickness="0" Padding="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <CheckBox x:Name="HexSendChk" Content="HEX 发送" Margin="0,0,12,0"/>
                        <CheckBox x:Name="EscapeChk" Content="转义 \r\n" Margin="0,0,12,0"/>
                        <TextBlock Text="校验" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ChecksumCombo" Width="150" Margin="0,0,12,0"/>
                        <TextBlock Text="行尾" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="LineEndingCombo" Width="110" Margin="0,0,12,0"/>
                        <CheckBox x:Name="TimerChk" Content="定时发送" Margin="0,0,6,0" Click="TimerChk_Click"/>
                        <TextBox x:Name="IntervalBox" Width="60" Style="{StaticResource FieldBox}"/>
                        <TextBlock Text="ms" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                    </WrapPanel>
                    <TextBox x:Name="SendBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="SendBox_PreviewKeyDown"
                             ToolTip="Ctrl+Enter 发送"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                        <Button x:Name="SendBtn" Content="发送" Style="{StaticResource AccentButton}" Height="46" FontSize="15" Click="SendBtn_Click"/>
                        <Button Content="清空发送" Margin="0,6,0,0" Click="ClearSend_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
