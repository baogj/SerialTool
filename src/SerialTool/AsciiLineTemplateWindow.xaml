<Window x:Class="SerialTool.AsciiLineTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASCII 行解析模板" Width="920" Height="620" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.RowSpan="2" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="＋" Width="36" Click="Add_Click" Margin="0,0,4,0"/>
                <Button Content="删" Width="36" Click="Del_Click" Margin="0,0,4,0"/>
                <Button Content="示例 KV" Click="SampleKv_Click" Margin="0,0,4,0"/>
                <Button Content="示例 CSV" Click="SampleCsv_Click"/>
            </StackPanel>
            <ListBox x:Name="TplList" DisplayMemberPath="Name" SelectionChanged="TplList_SelectionChanged"/>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FieldBox}" LostFocus="Field_Changed"/>
                    <TextBlock Grid.Row="1" Text="前缀" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PrefixBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" LostFocus="Field_Changed"/>
                    <TextBlock Grid.Row="2" Text="后缀" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SuffixBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" LostFocus="Field_Changed"/>
                    <TextBlock Grid.Row="3" Text="切分方式" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ModeCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="Mode_Changed"/>
                    <TextBlock x:Name="DelimLabel" Grid.Row="4" Text="分隔符" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DelimBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" LostFocus="Field_Changed"/>
                    <TextBlock Grid.Row="5" Text="键值分隔" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Grid.Row="5" Grid.Column="1">
                        <TextBox x:Name="KvSepBox" Width="80" Style="{StaticResource FieldBox}" LostFocus="Field_Changed"/>
                        <TextBlock Text="对分隔" Style="{StaticResource FieldLabel}" Margin="10,0,6,0"/>
                        <TextBox x:Name="KvPairBox" Width="80" Style="{StaticResource FieldBox}" LostFocus="Field_Changed"/>
                    </DockPanel>
                    <TextBlock Grid.Row="6" Text="编码" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="EncCombo" Grid.Row="6" Grid.Column="1" IsEditable="True"/>
                    <CheckBox x:Name="TrimChk" Grid.Row="7" Grid.Column="1" Content="去掉各段首尾空白" Margin="0,4,0,0" Click="Field_Changed"/>
                    <CheckBox x:Name="SkipEmptyChk" Grid.Row="8" Grid.Column="1" Content="忽略空行" Margin="0,2,0,0" Click="Field_Changed"/>
                </Grid>

                <DockPanel Margin="0,8,0,4">
                    <TextBlock Text="字段" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="＋ 字段" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="AddField_Click"/>
                        <Button Content="删字段" Style="{StaticResource SmallButton}" Click="DelField_Click"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="FieldGrid" Height="180" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="90"/>
                        <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                x:Name="TypeCol"/>
                        <DataGridTextColumn Header="列#" Binding="{Binding Index, UpdateSourceTrigger=LostFocus}" Width="44"/>
                        <DataGridTextColumn Header="键名" Binding="{Binding Key, UpdateSourceTrigger=LostFocus}" Width="80"/>
                        <DataGridTextColumn Header="起点" Binding="{Binding Start, UpdateSourceTrigger=LostFocus}" Width="44"/>
                        <DataGridTextColumn Header="宽度" Binding="{Binding Length, UpdateSourceTrigger=LostFocus}" Width="44"/>
                        <DataGridTextColumn Header="系数" Binding="{Binding Scale, UpdateSourceTrigger=LostFocus}" Width="50"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit, UpdateSourceTrigger=LostFocus}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="测试解析" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                <TextBox x:Name="TestBox" Style="{StaticResource FieldBox}" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto"/>
                <DockPanel Margin="0,6,0,0">
                    <Button Content="测试" Style="{StaticResource AccentButton}" Padding="14,2" Click="Test_Click"/>
                    <TextBlock x:Name="TestOut" Style="{StaticResource MutedText}" Margin="10,0,0,0" TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Style="{StaticResource AccentButton}" Width="88" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="88" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
