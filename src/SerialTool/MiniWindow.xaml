<Window x:Class="SerialTool.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SerialTool 迷你" Width="420" Height="300" MinWidth="260" MinHeight="180"
        WindowStyle="ToolWindow" ShowInTaskbar="True" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12">
    <DockPanel Margin="6">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="HexChk" Content="HEX" VerticalAlignment="Center" Margin="0,0,6,0" Click="HexChk_Click" ToolTip="以 HEX 显示接收数据"/>
                <CheckBox x:Name="TopChk" Content="置顶" VerticalAlignment="Center" Margin="0,0,6,0" Click="TopChk_Click"/>
                <Button Content="清空" Style="{StaticResource SmallButton}" Click="Clear_Click" Margin="0,0,4,0"/>
                <Button Content="还原" Style="{StaticResource AccentButton}" Click="Restore_Click" ToolTip="回到完整窗口"/>
            </StackPanel>
            <Button x:Name="OpenBtn" Content="打开" Style="{StaticResource SmallButton}" MinWidth="54" Click="Open_Click" Margin="0,0,6,0"/>
            <TextBlock x:Name="StateText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource AccentButton}" Click="Send_Click" Margin="4,0,0,0" MinWidth="50"/>
            <CheckBox x:Name="SendHexChk" DockPanel.Dock="Right" Content="HEX" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <TextBox x:Name="SendBox" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" KeyDown="SendBox_KeyDown"
                     ToolTip="回车发送；按主窗口的换行 / 校验设置组包"/>
        </DockPanel>
        <TextBox x:Name="RxView" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
    </DockPanel>
</Window>
