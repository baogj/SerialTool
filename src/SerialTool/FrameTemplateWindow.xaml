<Window x:Class="SerialTool.FrameTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帧模板编辑" Width="1100" Height="680" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 模板列表 -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="模板" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="新建" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="New_Click"/>
                <Button Content="复制" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="Copy_Click"/>
                <Button Content="删除" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="Delete_Click"/>
                <Button Content="示例" Style="{StaticResource SmallButton}" Click="Sample_Click" ToolTip="添加内置示例模板"/>
            </WrapPanel>
            <ListBox x:Name="TplList" DisplayMemberPath="Name" SelectionChanged="TplList_SelectionChanged"
                     Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
        </DockPanel>

        <!-- 模板内容 -->
        <Grid x:Name="EditorPanel" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,3,12,3"
                         TextChanged="Name_TextChanged"/>
                <TextBlock Grid.Column="2" Text="帧头 HEX" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="3" Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,3"
                         FontFamily="{StaticResource MonoFont}" ToolTip="必填，如 AA 55"/>

                <TextBlock Grid.Row="1" Text="帧尾 HEX" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Tail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,3,12,3"
                         FontFamily="{StaticResource MonoFont}" ToolTip="可选，如 0D 0A；留空表示无帧尾"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="校验" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                    <ComboBox x:Name="ChecksumCombo" Width="230" Margin="0,3,8,3" SelectedValuePath="Value" SelectedValue="{Binding Checksum}"/>
                    <TextBlock Text="起始偏移" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="44" Text="{Binding ChecksumFrom}" Style="{StaticResource FieldBox}" Margin="0,3,8,3"
                             ToolTip="校验从帧内此偏移计算到校验字节之前（0 = 从帧头开始）"/>
                    <CheckBox Content="字节交换" IsChecked="{Binding ChecksumSwap}" VerticalAlignment="Center"
                              ToolTip="16 位校验按相反的字节顺序存放"/>
                </StackPanel>

                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="帧内含长度字段" IsChecked="{Binding HasLength}" Margin="0,6,0,3"
                          x:Name="HasLengthChk" Click="Layout_Changed"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="固定长度" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="56" Text="{Binding FixedLength}" Style="{StaticResource FieldBox}" Margin="0,0,8,0"
                             ToolTip="无长度字段时使用的整帧长度；0 = 以帧尾结束"/>
                    <TextBlock Text="最大帧长" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="60" Text="{Binding MaxFrameLength}" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                    <TextBlock Text="半帧超时" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="56" Text="{Binding PartialTimeoutMs}" Style="{StaticResource FieldBox}" Margin="0,0,2,0"
                             ToolTip="未收完的半帧超过此时间未补齐则丢弃（0 = 不超时）"/>
                    <TextBlock Text="ms" Style="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel x:Name="LengthPanel" Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="18,0,0,0">
                    <TextBlock Text="偏移" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="44" Text="{Binding LengthOffset}" Style="{StaticResource FieldBox}" Margin="0,3,10,3"/>
                    <TextBlock Text="字节数" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="LengthSizeCombo" Width="56" SelectedItem="{Binding LengthSize}" Margin="0,3,10,3"/>
                    <CheckBox Content="大端" IsChecked="{Binding LengthBigEndian}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="长度值包含：" Style="{StaticResource FieldLabel}"/>
                    <CheckBox Content="帧头" IsChecked="{Binding LengthCountsHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="长度字段" IsChecked="{Binding LengthCountsLengthField}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="校验" IsChecked="{Binding LengthCountsChecksum}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="帧尾" IsChecked="{Binding LengthCountsTail}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="修正" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="44" Text="{Binding LengthAdjust}" Style="{StaticResource FieldBox}" Margin="0,3"
                             ToolTip="整帧长度额外加上的字节数（可为负）"/>
                </StackPanel>
                <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="整帧长度 = 长度值 + 修正 + 未被“包含”的部分（帧头、长度字段本身、校验、帧尾；帧头与长度字段之间的字节在两者都不包含时也会补上）。字段偏移从帧头第一个字节算起（0 起始）。"/>
            </Grid>

            <DockPanel Grid.Row="1" Margin="0,2,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="添加字段" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="AddField_Click"/>
                    <Button Content="删除字段" Style="{StaticResource SmallButton}" Click="RemoveField_Click"/>
                </StackPanel>
                <TextBlock Text="字段" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid x:Name="FieldGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn Header="偏移" Binding="{Binding Offset}" Width="60"/>
                    <DataGridComboBoxColumn x:Name="TypeColumn" Header="类型" SelectedItemBinding="{Binding Type}" Width="90"/>
                    <DataGridCheckBoxColumn Header="大端" Binding="{Binding BigEndian, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <DataGridTextColumn Header="系数" Binding="{Binding Scale}" Width="70"/>
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="长度(Bytes)" Binding="{Binding Length}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="测试解析" Style="{StaticResource AccentButton}" Padding="14,3" Margin="6,3,0,3" Click="Test_Click"/>
                    <TextBlock Text="测试数据" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TestBox" Style="{StaticResource FieldBox}" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                             ToolTip="粘贴一段或多段 HEX 数据，按当前模板拆帧并解析"/>
                </DockPanel>
                <TextBox x:Name="TestResult" Grid.Row="1" Height="96" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}" Style="{StaticResource FieldBox}" VerticalContentAlignment="Top" Margin="0,3,0,0"/>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="确定" Style="{StaticResource AccentButton}" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="取消" Width="90" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
