<Window x:Class="SerialTool.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新" Width="680" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="HeadText" FontSize="15" FontWeight="SemiBold" Text="正在检查更新…" TextWrapping="Wrap"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="AssetText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Top" Text="更新说明" Style="{StaticResource CardTitle}"/>
            <TextBox x:Name="NotesBox" Style="{StaticResource FieldBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RetryBtn" Content="重新检查" Click="Retry_Click" Margin="0,0,6,0"/>
                <Button x:Name="PageBtn" Content="打开发布页" Click="Page_Click" Margin="0,0,6,0"/>
                <Button x:Name="SkipBtn" Content="跳过此版本" Click="Skip_Click" Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="DownloadBtn" Content="下载并更新" Style="{StaticResource AccentButton}" Click="Download_Click" IsEnabled="False" Margin="0,0,6,0"/>
                <Button x:Name="CloseBtn" Content="关闭" Click="Close_Click" IsCancel="True"/>
            </StackPanel>
            <CheckBox x:Name="AutoChk" Content="启动时自动检查（每天最多一次）" VerticalAlignment="Center" Click="AutoChk_Click"/>
        </DockPanel>
    </Grid>
</Window>
