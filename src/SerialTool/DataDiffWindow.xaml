<Window x:Class="SerialTool.DataDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据对比" Width="1100" Height="760" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel>
            <TextBlock Text="对比方式" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ModeCombo" Width="110" Margin="0,0,10,0" SelectionChanged="Opt_Changed"/>
            <TextBlock Text="对齐" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="AlignCombo" Width="150" Margin="0,0,10,0" SelectionChanged="Opt_Changed"/>
            <TextBlock Text="编码" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="EncCombo" Width="80" Margin="0,0,10,0"/>
            <CheckBox x:Name="IgnoreCaseChk" Content="忽略大小写" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="IgnoreWsChk" Content="忽略空白" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Button Content="对比" Style="{StaticResource AccentButton}" Width="70" Click="Compare_Click" Margin="0,0,10,0"/>
            <Button Content="◀ 上一处" Style="{StaticResource SmallButton}" Click="Prev_Click" Margin="0,0,4,0"/>
            <Button Content="下一处 ▶" Style="{StaticResource SmallButton}" Click="Next_Click" Margin="0,0,4,0"/>
            <Button Content="交换左右" Style="{StaticResource SmallButton}" Click="Swap_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="A（左）" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Content="粘贴" Style="{StaticResource SmallButton}" Tag="A" Click="Paste_Click" Margin="0,0,4,0"/>
                    <Button Content="打开文件…" Style="{StaticResource SmallButton}" Tag="A" Click="Open_Click" Margin="0,0,4,0"/>
                    <Button Content="取接收区" Style="{StaticResource SmallButton}" Tag="A" Click="FromRx_Click" Margin="0,0,4,0"/>
                    <Button Content="取录制…" Style="{StaticResource SmallButton}" Tag="A" Click="FromRec_Click" Margin="0,0,4,0"/>
                    <Button Content="清空" Style="{StaticResource SmallButton}" Tag="A" Click="ClearIn_Click"/>
                </WrapPanel>
                <TextBox x:Name="InA" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="B（右）" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Content="粘贴" Style="{StaticResource SmallButton}" Tag="B" Click="Paste_Click" Margin="0,0,4,0"/>
                    <Button Content="打开文件…" Style="{StaticResource SmallButton}" Tag="B" Click="Open_Click" Margin="0,0,4,0"/>
                    <Button Content="取接收区" Style="{StaticResource SmallButton}" Tag="B" Click="FromRx_Click" Margin="0,0,4,0"/>
                    <Button Content="取录制…" Style="{StaticResource SmallButton}" Tag="B" Click="FromRec_Click" Margin="0,0,4,0"/>
                    <Button Content="清空" Style="{StaticResource SmallButton}" Tag="B" Click="ClearIn_Click"/>
                </WrapPanel>
                <TextBox x:Name="InB" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8" Padding="8,6">
            <StackPanel>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Text="粘贴或载入两段数据后点「对比」。HEX 模式按字节对比，文本模式按行对比。"/>
                <TextBlock x:Name="CurrentText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RichTextBox x:Name="ViewA" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" IsDocumentEnabled="True"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
            <RichTextBox x:Name="ViewB" Grid.Column="2" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12.5" IsDocumentEnabled="True"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
        </Grid>
    </Grid>
</Window>
