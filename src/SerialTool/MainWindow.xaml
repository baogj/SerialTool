                                            <Button Content="Modbus 示例" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="ScriptSampleModbus_Click"/>
                                            <Button x:Name="ScriptSampleEchoBtn" Content="回环示例" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="ScriptSampleEcho_Click"
