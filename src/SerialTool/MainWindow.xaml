<Window x:Class="SerialTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:f="clr-namespace:SerialTool.Features"
        xmlns:local="clr-namespace:SerialTool"
        Title="SerialTool 串口调试助手" Width="1280" Height="880" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="app.ico"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶栏：标题 + 主题 ============ -->
        <Border Background="{DynamicResource TopBarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="主题" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ThemeCombo" Width="104" Margin="0" SelectionChanged="ThemeCombo_SelectionChanged"
                              ToolTip="浅色 / 深色 / 跟随 Windows 系统设置"/>
                </StackPanel>
                <TextBlock x:Name="AppTitleText" Text="SerialTool 串口调试助手" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ============ v1.5：会话标签页 ============ -->
        <TabControl x:Name="SessionTabs" Grid.Row="1" Margin="8,6,8,0" Padding="0" BorderThickness="0" Background="Transparent"
                    SelectionChanged="SessionTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ThemedTabItem}"/>
            </TabControl.Resources>
            <TabItem x:Name="MainSessionTab" Header="会话 1">
        <Grid Margin="2,6,2,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧设置面板 ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 串口设置 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="连接设置" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="类型" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ConnTypeCombo" Grid.Column="1" SelectionChanged="ConnTypeCombo_SelectionChanged"
                                          ToolTip="主连接类型：串口 / TCP 客户端 / TCP 服务器 / UDP。收发、脚本、自动回复、校验、波形、Modbus 主站都走主连接"/>
                            </Grid>
                            <StackPanel x:Name="SerialPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="端口" Style="{StaticResource FieldLabel}"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortCombo" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
                                    <Button x:Name="RefreshBtn" Grid.Column="1" Content="刷新" Style="{StaticResource SmallButton}"
                                            Margin="4,3,0,3" ToolTip="刷新串口列表 (F5)" Click="RefreshBtn_Click"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="波特率" Style="{StaticResource FieldLabel}"/>
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BaudCombo" IsEditable="True" IsTextSearchEnabled="False"
                                              ToolTip="可直接输入自定义波特率，回车生效"
                                              SelectionChanged="BaudCombo_SelectionChanged" LostFocus="BaudCombo_LostFocus"
                                              PreviewKeyDown="BaudCombo_PreviewKeyDown"/>
                                    <Button x:Name="BaudDetectBtn" Grid.Column="1" Content="识别" Style="{StaticResource SmallButton}"
                                            Margin="4,3,0,3" ToolTip="在所选串口上自动识别波特率（1200 ~ 921600）" Click="BaudDetect_Click"/>
                                </Grid>

                                <TextBlock Grid.Row="2" Text="数据位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DataBitsCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="PortParam_Changed"/>

                                <TextBlock Grid.Row="3" Text="停止位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="StopBitsCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="PortParam_Changed"/>

                                <TextBlock Grid.Row="4" Text="校验位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ParityCombo" Grid.Row="4" Grid.Column="1" SelectionChanged="PortParam_Changed"/>

                                <TextBlock Grid.Row="5" Text="流控" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="FlowCombo" Grid.Row="5" Grid.Column="1" SelectionChanged="PortParam_Changed"/>
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <CheckBox x:Name="DtrChk" Content="DTR" Click="DtrChk_Click"/>
                                <CheckBox x:Name="RtsChk" Content="RTS" Click="RtsChk_Click"/>
                                <CheckBox x:Name="AutoReconnectChk" Content="自动重连" ToolTip="设备拔出后重新插入时自动打开"/>
                            </UniformGrid>
                            </StackPanel>

                            <!-- 网络参数 -->
                            <StackPanel x:Name="NetPanel" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="RemoteHostLabel" Text="远程主机" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RemoteHostBox" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3"
                                             ToolTip="IP 或主机名，如 192.168.1.10（UDP 可留空：回复最后一个来包地址）"/>
                                    <TextBlock x:Name="RemotePortLabel" Grid.Row="1" Text="远程端口" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RemotePortBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3"/>
                                    <TextBlock x:Name="LocalPortLabel" Grid.Row="2" Text="本地端口" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LocalPortBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3"
                                             ToolTip="监听 / 绑定的本地端口（UDP 填 0 由系统分配）"/>
                                </Grid>
                                <StackPanel x:Name="ServerPanel" Margin="0,4,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="断开选中" Style="{StaticResource SmallButton}"
                                                Click="DisconnectClients_Click" ToolTip="断开列表中选中的客户端"/>
                                        <TextBlock x:Name="ServerClientsTitle" Text="已连接客户端（0）" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ListBox x:Name="ServerClientList" Height="78" Margin="0,3,0,3" SelectionMode="Extended"
                                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}"
                                             BorderBrush="{DynamicResource InputBorderBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                             SelectionChanged="ServerClientList_SelectionChanged"/>
                                    <CheckBox x:Name="ServerSendSelectedChk" Content="只发送给选中的客户端（否则发给全部）"
                                              Click="ServerSendSelectedChk_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="OpenBtn" Content="打开串口" Style="{StaticResource AccentButton}" Height="36"
                                    FontSize="14" Margin="0,8,0,0" Click="OpenBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 接收设置 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="接收设置" Style="{StaticResource CardTitle}"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="HexDisplayChk" Content="HEX 显示" Click="RxOption_Click"/>
                                <CheckBox x:Name="TimestampChk" Content="显示时间戳" Click="RxOption_Click"/>
                                <CheckBox x:Name="ShowTxChk" Content="显示发送" Click="RxOption_Click"/>
                                <CheckBox x:Name="AutoScrollChk" Content="自动滚动" Click="AutoScrollChk_Click"/>
                                <CheckBox x:Name="PauseChk" Content="暂停显示" Click="PauseChk_Click"/>
                                <CheckBox x:Name="LogChk" Content="记录到文件" Click="LogChk_Click"
                                          ToolTip="把显示内容实时追加写入日志文件"/>
                            </UniformGrid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="编码" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="EncodingCombo" Grid.Column="1" SelectionChanged="EncodingCombo_SelectionChanged"
                                          ToolTip="接收显示与文本发送使用的字符编码"/>
                                <TextBlock Grid.Row="1" Text="分帧" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="FrameGapBox" Width="70" Style="{StaticResource FieldBox}" LostFocus="FrameGapBox_LostFocus"
                                             ToolTip="开启时间戳/显示发送时，两次数据间隔超过该值则另起一行"/>
                                    <TextBlock Text="ms（时间戳分行间隔）" Style="{StaticResource MutedText}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="协议" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ProtocolCombo" Grid.Row="2" Grid.Column="1"
                                          ToolTip="普通：原样显示；AT：命令/回显着色；Modbus RTU：帧解析+CRC（接收页顶部也可切换）"
                                          SelectionChanged="ProtocolCombo_SelectionChanged"/>
                            </Grid>
                            <!-- 关键字高亮 / 自动回复 -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="HighlightChk" Content="关键字高亮" Click="HighlightChk_Click"
                                          ToolTip="按规则给匹配的文字加背景色（启用后普通视图也切换为着色行视图）"/>
                                <CheckBox x:Name="AutoReplyChk" Grid.Column="1" Content="自动回复" Click="AutoReplyChk_Click"
                                          ToolTip="收到匹配内容时自动发送规则里的回复（全局开关，每条规则有冷却时间防回环）"/>
                                <Button Grid.Column="2" Content="规则…" Style="{StaticResource SmallButton}" Click="EditRules_Click"
                                        ToolTip="编辑高亮 / 自动回复规则"/>
                            </Grid>
                            <TextBlock x:Name="RulesSummaryText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <UniformGrid Columns="3" Margin="0,8,0,0">
                                <Button Content="清空接收" Margin="0,0,3,0" Click="ClearRx_Click"/>
                                <Button Content="保存接收…" Margin="3,0,3,0" Click="SaveRx_Click"/>
                                <Button Content="导出 CSV…" Margin="3,0,0,0" Click="ExportCsv_Click"
                                        ToolTip="把收发数据按行导出为 CSV：时间、方向、来源、字节数、HEX、文本（不受显示设置影响）"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 发送设置 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="发送设置" Style="{StaticResource CardTitle}"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="HexSendChk" Content="HEX 发送" Click="HexSendChk_Click"/>
                                <CheckBox x:Name="EscapeChk" Content="解析转义符" Click="ChecksumInput_Changed"
                                          ToolTip="文本模式下支持 \r \n \t \0 \\ \xHH"/>
                            </UniformGrid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="校验" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ChecksumCombo" Grid.Column="1" SelectionChanged="ChecksumCombo_SelectionChanged"
                                          ToolTip="发送时对内容计算校验并追加到末尾（在行尾之前）；对手动、定时、快捷指令、脚本、自动回复都生效"/>
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,1,0,3">
                                    <Button DockPanel.Dock="Right" Content="计算器…" Style="{StaticResource SmallButton}"
                                            Click="ChecksumCalc_Click" ToolTip="校验计算器：同时显示所有算法的结果"/>
                                    <TextBlock x:Name="ChecksumPreview" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,0,6,0"/>
                                </DockPanel>
                                <TextBlock Grid.Row="2" Text="行尾" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LineEndingCombo" Grid.Row="2" Grid.Column="1" ToolTip="每次发送时自动追加的结尾字符（在校验之后）"/>
                                <CheckBox x:Name="TimedChk" Grid.Row="3" Content="定时" Click="TimedChk_Click" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="IntervalBox" Width="70" Style="{StaticResource FieldBox}" LostFocus="IntervalBox_LostFocus"/>
                                    <TextBlock Text="ms 周期发送发送区内容" Style="{StaticResource MutedText}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 右侧收发区 ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="SendRow" Height="250" MinHeight="170"/>
                </Grid.RowDefinitions>

                <!-- 接收 / 波形 / 脚本 -->
                <Border Style="{StaticResource Card}" Margin="0" Padding="0" Background="{DynamicResource RxBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}">
                    <TabControl x:Name="MainTabs" Background="{DynamicResource RxBgBrush}" BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource ThemedTabItem}"/>
                        </TabControl.Resources>

                        <!-- 接收 -->
                        <TabItem Header="接收" x:Name="RxTab">
                            <Grid Background="{DynamicResource RxBgBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="12,4">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border x:Name="PausedBadge" Background="#F59E0B" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="已暂停" Foreground="Black" FontSize="12"/>
                                            </Border>
                                            <Border x:Name="LogBadge" Background="#10B981" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="记录中" Foreground="Black" FontSize="12"/>
                                            </Border>
                                            <Border x:Name="AutoReplyBadge" Background="#A78BFA" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="自动回复" Foreground="Black" FontSize="12"/>
                                            </Border>
                                            <Button Content="查找" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="OpenSearch_Click"
                                                    ToolTip="查找 / 过滤 (Ctrl+F)"/>
                                            <Button Content="清空" Style="{StaticResource PanelButton}" Click="ClearRx_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="接收区" Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <TextBlock Text="协议" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="ProtocolTopCombo" Width="120" Height="24" Margin="0"
                                                      ToolTip="切换接收解析模式：普通 / AT / Modbus RTU"
                                                      SelectionChanged="ProtocolTopCombo_SelectionChanged"/>
                                            <TextBlock x:Name="ViewHint" Style="{StaticResource MutedText}" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- 查找 / 过滤栏（Ctrl+F） -->
                                <Border x:Name="SearchBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource RxHeaderBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,1" Padding="10,3">
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="查找" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="SearchBox" Width="200" Style="{StaticResource FieldBox}" Margin="0,2"
                                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                                 ToolTip="Enter 下一个，Shift+Enter 上一个，Esc 关闭"/>
                                        <CheckBox x:Name="SearchRegexChk" Content="正则" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource RxHeaderFgBrush}" Click="SearchOption_Click"/>
                                        <CheckBox x:Name="SearchCaseChk" Content="区分大小写" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource RxHeaderFgBrush}" Click="SearchOption_Click"/>
                                        <Button Content="↑ 上一个" Style="{StaticResource PanelButton}" Margin="8,0,0,0" Click="SearchPrev_Click"/>
                                        <Button Content="↓ 下一个" Style="{StaticResource PanelButton}" Margin="4,0,0,0" Click="SearchNext_Click"/>
                                        <TextBlock x:Name="SearchCountText" Text="" MinWidth="90" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource RxHeaderFgBrush}" FontFamily="{StaticResource MonoFont}"/>
                                        <Rectangle Width="1" Height="18" Fill="{DynamicResource CardBorderBrush}" Margin="6,0,10,0"/>
                                        <CheckBox x:Name="FilterChk" Content="过滤" VerticalAlignment="Center" Click="FilterChk_Click"
                                                  Foreground="{DynamicResource RxHeaderFgBrush}"
                                                  ToolTip="只显示（或隐藏）包含查找内容的行；会切换为行视图"/>
                                        <ComboBox x:Name="FilterModeCombo" Width="110" Height="24" Margin="6,0,0,0"
                                                  SelectionChanged="FilterMode_SelectionChanged"/>
                                        <Button Content="清除" Style="{StaticResource PanelButton}" Margin="8,0,0,0" Click="SearchClear_Click"
                                                ToolTip="清除查找词与过滤，恢复全部行"/>
                                        <Button Content="✕" Style="{StaticResource PanelButton}" Margin="4,0,0,0" Click="SearchClose_Click"
                                                ToolTip="关闭查找栏 (Esc)"/>
                                    </WrapPanel>
                                </Border>
                                <!-- 普通：TextBox；协议 / 高亮：虚拟化着色行列表 -->
                                <TextBox x:Name="RxBox" Grid.Row="2" IsInactiveSelectionHighlightEnabled="True" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         Background="{DynamicResource RxBgBrush}" Foreground="{DynamicResource RxFgBrush}"
                                         SelectionBrush="{DynamicResource RxSelectionBrush}"
                                         BorderThickness="0" Padding="8,6"
                                         FontFamily="{StaticResource MonoFont}" FontSize="13"
                                         TextWrapping="Wrap" AcceptsReturn="True" IsUndoEnabled="False" UndoLimit="0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         VerticalContentAlignment="Top"/>
                                <ListBox x:Name="ProtocolList" Grid.Row="2" Visibility="Collapsed"
                                         Background="{DynamicResource RxBgBrush}" BorderThickness="0" Padding="6,4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Extended"
                                         KeyDown="ProtocolList_KeyDown">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制选中行" InputGestureText="Ctrl+C" Click="CopySelectedLines_Click"/>
                                            <MenuItem Header="复制全部" Click="CopyAllLines_Click"/>
                                            <Separator/>
                                            <MenuItem Header="清空" Click="ClearRx_Click"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RxSelectionBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <f:ColoredLineBlock Line="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- 波形 -->
                        <TabItem Header="波形">
                            <Grid Background="{DynamicResource RxBgBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <CheckBox x:Name="WaveShowTxChk" Content="显示 TX" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                      Margin="0,0,12,0" Click="WaveOption_Click"/>
                                            <CheckBox x:Name="WavePauseChk" Content="暂停" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                      Margin="0,0,12,0" Click="WavePause_Click"/>
                                            <TextBlock Text="窗口" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="WaveWindowCombo" Width="90" Height="24" Margin="0" SelectionChanged="WaveWindow_Changed"/>
                                            <Button Content="清空波形" Style="{StaticResource PanelButton}" Margin="10,0,0,0" Click="WaveClear_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="字节流波形（Y=0..255）" Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
