                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="脚本类型" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="ScriptLangCombo" Width="70" Height="24" Margin="0,0,10,0" SelectionChanged="ScriptLangCombo_SelectionChanged"
                                                      ToolTip="DSL：简单指令脚本（SEND / WAITFOR …）；Lua：完整 Lua 5.2 脚本（MoonSharp）"/>
                                            <TextBlock x:Name="ScriptHelpText" Text="SEND / SENDHEX / SENDHEXRAW / CHECKSUM / SLEEP / WAITFOR / LOG"
                                                       Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                            <TextBlock x:Name="ScriptStatusText" Foreground="#FBBF24" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBox x:Name="ScriptBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                         Background="{DynamicResource RxBgBrush}" Foreground="{DynamicResource RxFgBrush}"
                                         BorderThickness="0" Padding="8"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>
                                <TextBox x:Name="ScriptOutBox" Grid.Row="3" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Background="{DynamicResource ScriptOutBgBrush}" Foreground="{DynamicResource ScriptOutFgBrush}"
                                         BorderThickness="0" Padding="8"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </TabItem>
                        <!-- 曲线 -->
                        <TabItem Header="曲线">
                            <Grid Background="{DynamicResource RxBgBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <CheckBox x:Name="CurvePauseChk" Content="暂停" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                      Margin="0,0,12,0" Click="CurvePause_Click"/>
                                            <TextBlock Text="窗口" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CurveWindowCombo" Width="90" Height="24" Margin="0" SelectionChanged="CurveWindow_Changed"
                                                      ToolTip="显示最近多少个样本（行）"/>
                                            <Button Content="清空" Style="{StaticResource PanelButton}" Margin="10,0,0,0" Click="CurveClear_Click"/>
                                            <Button Content="导出 CSV…" Style="{StaticResource PanelButton}" Margin="6,0,0,0" Click="CurveExport_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CurveTitle" Text="数值曲线（从接收的文本行解析：temp=23.5,hum=40 或 1.2,3.4,5）"
                                                   Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="CurveHost" Grid.Row="1" Background="{DynamicResource RxBgBrush}"/>
                            </Grid>
                        </TabItem>

                        <!-- Modbus 主站 -->
                        <TabItem Header="Modbus 主站">
                            <Grid Background="{DynamicResource RxBgBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <TextBlock x:Name="MbStatsText" Text="成功 0  超时 0  CRC错 0  异常 0" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                       FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="统计清零" Style="{StaticResource PanelButton}" Click="MbResetStats_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Modbus 主站" Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Text="帧格式" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="MbFramingCombo" Width="170" Height="24" Margin="0" SelectionChanged="MbOption_Changed"
                                                      ToolTip="RTU：地址+PDU+CRC（串口或透传网关）；Modbus TCP：MBAP 头，无 CRC（直连 Modbus TCP 设备）"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <WrapPanel Grid.Row="1" Margin="10,6,10,0">
                                    <TextBlock Text="从站" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MbSlaveBox" Width="44" Style="{StaticResource FieldBox}" Margin="0,3,12,3"/>
                                    <TextBlock Text="功能" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="MbFuncCombo" Width="150" Margin="0,3,12,3" SelectionChanged="MbFunc_Changed"/>
                                    <TextBlock Text="起始地址" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MbStartBox" Width="60" Style="{StaticResource FieldBox}" Margin="0,3,12,3"
                                             ToolTip="0 起始的协议地址（如 40001 对应 0），支持 0x 十六进制"/>
                                    <TextBlock x:Name="MbQtyLabel" Text="数量" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MbQtyBox" Width="50" Style="{StaticResource FieldBox}" Margin="0,3,12,3"/>
                                    <TextBlock Text="超时" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MbTimeoutBox" Width="56" Style="{StaticResource FieldBox}" Margin="0,3,2,3"/>
                                    <TextBlock Text="ms" Style="{StaticResource MutedText}" Margin="0,0,12,0"/>
                                </WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="10,0,10,6">
                                    <TextBlock x:Name="MbValuesLabel" Text="写入值" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MbValuesBox" Width="230" Style="{StaticResource FieldBox}" Margin="0,3,12,3"
                                             ToolTip="逗号或空格分隔。寄存器：十进制 / 0x 十六进制 / 负数；Float32 等 32 位格式每个值占两个寄存器；线圈：1/0 或 ON/OFF"/>
                                    <TextBlock Text="显示" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="MbFormatCombo" Width="140" Margin="0,3,12,3" SelectionChanged="MbOption_Changed"/>
                                    <TextBlock Text="字节序" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="MbOrderCombo" Width="80" Margin="0,3,12,3" SelectionChanged="MbOption_Changed"
                                              ToolTip="32 位数值跨两个寄存器的字节顺序（A=最高字节）：ABCD 大端 / CDAB 字交换 / BADC 字节交换 / DCBA 小端"/>
                                    <Button x:Name="MbExecBtn" Content="读取" Style="{StaticResource AccentButton}" Padding="18,3" Margin="0,3,10,3"
                                            Click="MbExec_Click"/>
                                    <CheckBox x:Name="MbPollChk" Content="轮询" VerticalAlignment="Center" Click="MbPoll_Click"/>
                                    <TextBox x:Name="MbPollBox" Width="56" Style="{StaticResource FieldBox}" Margin="6,3,2,3"/>
                                    <TextBlock Text="ms" Style="{StaticResource MutedText}"/>
                                </WrapPanel>
                                <Grid Grid.Row="3" Margin="10,0,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="MbBanner" Padding="8,4" CornerRadius="4" Margin="0,0,0,4" Background="{DynamicResource RxHeaderBgBrush}">
                                        <TextBlock x:Name="MbBannerText" Text="选择功能码后点击“读取 / 写入”。请求通过当前主连接发送（串口、TCP、UDP 均可）。"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="MbFrameText" Grid.Row="1" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <DataGrid x:Name="MbGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                              EnableRowVirtualization="True" FontFamily="{StaticResource MonoFont}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="70"/>
                                            <DataGridTextColumn Header="地址(Hex)" Binding="{Binding AddressHex}" Width="80"/>
                                            <DataGridTextColumn Header="原始值" Binding="{Binding Raw}" Width="90"/>
                                            <DataGridTextColumn Header="显示值" Binding="{Binding Value}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- 多端口监视 -->
                        <TabItem Header="多端口">
                            <Grid Background="{DynamicResource RxBgBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <CheckBox x:Name="MonitorTxChk" Content="显示发送" IsChecked="True" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="MonitorTimeChk" Content="时间戳" IsChecked="True" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Button Content="+ 添加端口" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="MonitorAdd_Click"/>
                                            <Button Content="全部打开" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="MonitorOpenAll_Click"/>
                                            <Button Content="全部关闭" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="MonitorCloseAll_Click"/>
                                            <Button Content="清空" Style="{StaticResource PanelButton}" Click="MonitorClear_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="多端口监视（同时打开多个串口，合并显示，每个端口一种颜色）" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="MonitorPortsPanel" Margin="8,4"/>
                                </ScrollViewer>
                                <ListBox x:Name="MonitorList" Grid.Row="2" Background="{DynamicResource RxBgBrush}" BorderThickness="0,1,0,0"
                                         BorderBrush="{DynamicResource CardBorderBrush}" Padding="6,4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Extended" KeyDown="MonitorList_KeyDown">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制选中行" InputGestureText="Ctrl+C" Click="MonitorCopy_Click"/>
                                            <MenuItem Header="清空" Click="MonitorClear_Click"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RxSelectionBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <f:ColoredLineBlock Line="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="3" Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <TextBlock Text="发送到" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="MonitorTargetCombo" Width="140" Height="24" Margin="0,0,8,0"/>
                                        <CheckBox x:Name="MonitorHexChk" Content="HEX" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource AccentButton}" Padding="16,2" Click="MonitorSend_Click"/>
                                        <TextBox x:Name="MonitorSendBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0" FontFamily="{StaticResource MonoFont}"
                                                 PreviewKeyDown="MonitorSendBox_PreviewKeyDown"
                                                 ToolTip="Enter 发送；使用“发送设置”里的转义、校验和行尾"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- 串口转发 -->
                        <TabItem Header="串口转发">
                            <Grid Background="{DynamicResource RxBgBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                    <TextBlock Text="串口转发（主连接 ⇄ 网络，双向透传）" Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,10" MaxWidth="640" HorizontalAlignment="Left">
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                               Text="把左侧打开的主连接（通常是串口）与一个网络端点桥接：主连接收到的数据转发到网络，网络收到的数据写入主连接。主连接断开 / 自动重连期间转发保持运行。网络写回串口的数据在接收区显示为“发送”。"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="网络端" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="BridgeTypeCombo" Grid.Column="1" SelectionChanged="BridgeType_Changed"/>
                                        <TextBlock Grid.Row="1" Text="远程主机" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="BridgeHostBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Text="远程端口" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="BridgePortBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Text="本地端口" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="BridgeLocalPortBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="BridgeBtn" Content="启动转发" Style="{StaticResource AccentButton}" Padding="18,4" Click="BridgeBtn_Click"/>
                                        <Ellipse x:Name="BridgeDot" Width="9" Height="9" Fill="#9CA3AF" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BridgeStatusText" Text="未启动" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource RxHeaderBgBrush}">
                                        <TextBlock x:Name="BridgeCountText" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextBrush}"
                                                   Text="主连接 → 网络：0 字节    网络 → 主连接：0 字节    丢弃：0 字节"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- v1.4：扩展工具 -->
                        <TabItem Header="扩展工具" x:Name="ToolsTab">
                            <TabControl x:Name="ToolTabs" Background="{DynamicResource RxBgBrush}" BorderThickness="0" Padding="0">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource ThemedTabItem}"/>
                                </TabControl.Resources>

                                <!-- 帧解析 -->
                                <TabItem Header="帧解析">
                                    <Grid Background="{DynamicResource RxBgBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <TextBlock x:Name="FrameStatsText" Text="正确 0  错误 0  丢弃 0 字节" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Content="导出 CSV…" Style="{StaticResource PanelButton}" Margin="0,0,6,0" Click="FrameExport_Click"/>
                                                    <Button Content="清空" Style="{StaticResource PanelButton}" Click="FrameClear_Click"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="FrameEnableChk" Content="启用解析" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                              VerticalAlignment="Center" Margin="0,0,12,0" Click="FrameOption_Click"/>
                                                    <TextBlock Text="模板" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="FrameTplCombo" Width="210" Height="24" Margin="0" SelectionChanged="FrameTpl_Changed"
                                                              DisplayMemberPath="Name"/>
                                                    <Button Content="编辑模板…" Style="{StaticResource PanelButton}" Margin="6,0,12,0" Click="FrameEdit_Click"/>
                                                    <CheckBox x:Name="FrameTxChk" Content="含发送" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0" Click="FrameOption_Click"/>
                                                    <CheckBox x:Name="FrameBadOnlyChk" Content="只看错误帧" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                              VerticalAlignment="Center" Click="FrameBadOnly_Click"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock x:Name="FrameInfoText" Grid.Row="1" Style="{StaticResource MutedText}" Margin="10,4" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource MonoFont}"/>
                                        <DataGrid x:Name="FrameGrid" Grid.Row="2" Margin="10,0,10,8" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" FontFamily="{StaticResource MonoFont}">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- Modbus 从站 -->
                                <TabItem Header="Modbus 从站">
                                    <Grid Background="{DynamicResource RxBgBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <TextBlock x:Name="SlaveStatsText" Text="请求 0  异常 0  CRC错 0" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Content="清空日志" Style="{StaticResource PanelButton}" Click="SlaveClearLog_Click"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="SlaveEnableChk" Content="启用从站模拟" Foreground="{DynamicResource RxHeaderFgBrush}"
                                                              FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Click="SlaveEnable_Click"
                                                              ToolTip="启用后，主连接收到发给本站的请求会自动应答（串口、TCP、UDP 均可）"/>
                                                    <TextBlock Text="站号" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox x:Name="SlaveIdBox" Width="44" Height="24" Style="{StaticResource FieldBox}" Margin="0,0,12,0"
                                                             LostFocus="SlaveOption_Changed" ToolTip="1~247；0 号广播请求只执行不应答"/>
                                                    <TextBlock Text="帧格式" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="SlaveFramingCombo" Width="120" Height="24" Margin="0,0,12,0" SelectionChanged="SlaveOption_Changed"/>
                                                    <TextBlock Text="表大小" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox x:Name="SlaveSizeBox" Width="56" Height="24" Style="{StaticResource FieldBox}" Margin="0,0,4,0"
                                                             ToolTip="地址 0 ~ (表大小-1) 有效，超出范围返回异常码 02；最大 10000"/>
                                                    <Button Content="应用" Style="{StaticResource PanelButton}" Margin="0,0,8,0" Click="SlaveResize_Click"/>
                                                    <Button Content="全部清零" Style="{StaticResource PanelButton}" Click="SlaveZero_Click"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="10,4" TextWrapping="Wrap"
                                                   Text="支持功能码 01/02/03/04/05/06/0F/10。表格可直接编辑（寄存器支持十进制、0x 十六进制、负数）；主站写入后表格自动刷新。非法地址返回异常 02，非法数量/数值返回 03，不支持的功能码返回 01。"/>
                                        <Grid Grid.Row="2" Margin="10,0,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="440"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <DataGrid x:Name="SlaveGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                      CanUserSortColumns="False" HeadersVisibility="Column" SelectionUnit="Cell"
                                                      EnableRowVirtualization="True" FontFamily="{StaticResource MonoFont}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" IsReadOnly="True" Width="56"/>
                                                    <DataGridTextColumn Header="保持寄存器" Binding="{Binding HoldingText, UpdateSourceTrigger=LostFocus}" Width="96"/>
                                                    <DataGridTextColumn Header="输入寄存器" Binding="{Binding InputText, UpdateSourceTrigger=LostFocus}" Width="96"/>
                                                    <DataGridCheckBoxColumn Header="线圈" Binding="{Binding Coil, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                    <DataGridCheckBoxColumn Header="离散输入" Binding="{Binding Discrete, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
                                            <DataGrid x:Name="SlaveLogGrid" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True"
                                                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                                      EnableRowVirtualization="True" FontFamily="{StaticResource MonoFont}">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="96"/>
                                                    <DataGridTextColumn Header="站" Binding="{Binding Slave}" Width="36"/>
                                                    <DataGridTextColumn Header="说明" Binding="{Binding Summary}" Width="220"/>
                                                    <DataGridTextColumn Header="请求" Binding="{Binding Request}" Width="200"/>
                                                    <DataGridTextColumn Header="应答" Binding="{Binding Response}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </TabItem>

                                <!-- 文件传输 -->
                                <TabItem Header="文件传输">
                                    <Grid Background="{DynamicResource RxBgBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                            <TextBlock Text="文件传输（XModem / XModem-1K / YModem，通过当前主连接）" Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,8" MaxWidth="760" HorizontalAlignment="Left">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="协议" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="XferProtoCombo" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,3"/>
                                                <TextBlock Grid.Row="1" Text="发送文件" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="XferFilesBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3" IsReadOnly="True"
                                                         ToolTip="YModem 可选择多个文件（批量发送）；XModem 只能一个"/>
                                                <Button Grid.Row="1" Grid.Column="2" Content="选择文件…" Style="{StaticResource SmallButton}" Margin="6,3,0,3" Click="XferPickFiles_Click"/>
                                                <TextBlock Grid.Row="2" Text="接收目录" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="XferDirBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3"
                                                         ToolTip="接收的文件保存到此目录；XModem 没有文件名，按时间自动命名；同名文件自动加序号"/>
                                                <Button Grid.Row="2" Grid.Column="2" Content="浏览…" Style="{StaticResource SmallButton}" Margin="6,3,0,3" Click="XferPickDir_Click"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="XferSendBtn" Content="发送" Style="{StaticResource AccentButton}" Padding="20,4" Click="XferSend_Click"/>
                                                <Button x:Name="XferRecvBtn" Content="接收" Style="{StaticResource AccentButton}" Padding="20,4" Margin="8,0,0,0" Click="XferRecv_Click"/>
                                                <Button x:Name="XferCancelBtn" Content="取消" Style="{StaticResource DangerButton}" Padding="20,4" Margin="8,0,0,0"
                                                        IsEnabled="False" Click="XferCancel_Click"/>
                                                <TextBlock x:Name="XferStatusText" Text="空闲" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            </StackPanel>
                                            <ProgressBar x:Name="XferProgress" Height="16" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TabBgBrush}" BorderThickness="0"/>
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="传输期间暂停接收区显示、自动回复、Modbus 从站和串口转发，结束后自动恢复。每块最多重试 10 次，取消时发送 CAN×5 通知对方。"/>
                                        </StackPanel>
                                        <TextBox x:Name="XferLogBox" Grid.Row="2" Margin="14,0,14,8" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Style="{StaticResource FieldBox}"
                                                 VerticalContentAlignment="Top" AcceptsReturn="True"/>
                                    </Grid>
                                </TabItem>

                                <!-- 录制回放 -->
                                <TabItem Header="录制回放">
                                    <Grid Background="{DynamicResource RxBgBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                            <TextBlock Text="会话录制 / 回放（.jsonl，每行一条带时间戳的收发记录）" Foreground="{DynamicResource RxHeaderFgBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,8" MaxWidth="760" HorizontalAlignment="Left">
                                            <TextBlock Text="录制" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="RecBtn" Content="开始录制…" Style="{StaticResource AccentButton}" Padding="18,4" Click="Rec_Click"/>
                                                <Ellipse x:Name="RecDot" Width="9" Height="9" Fill="#9CA3AF" Margin="12,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="RecStatusText" Text="未录制" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap"
                                                       Text="录制主连接的所有接收(RX)与发送(TX)数据，包括时间戳与网络来源地址。"/>

                                            <TextBlock Text="回放" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="录制文件" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="ReplayFileBox" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,3" IsReadOnly="True"/>
                                                <Button Grid.Column="2" Content="打开…" Style="{StaticResource SmallButton}" Margin="6,3,0,3" Click="ReplayOpen_Click"/>
                                                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3">
                                                    <TextBlock Text="回放到" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox x:Name="ReplayTargetCombo" Width="150" Margin="0,3,12,3"/>
                                                    <TextBlock Text="内容" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox x:Name="ReplayContentCombo" Width="120" Margin="0,3,12,3"/>
                                                    <TextBlock Text="速度" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox x:Name="ReplaySpeedCombo" Width="110" Margin="0,3,0,3" SelectionChanged="ReplaySpeed_Changed"/>
                                                </WrapPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="ReplayBtn" Content="开始回放" Style="{StaticResource AccentButton}" Padding="18,4" Click="ReplayStart_Click"/>
                                                <Button x:Name="ReplayPauseBtn" Content="暂停" Style="{StaticResource SmallButton}" Padding="18,4" Margin="8,0,0,0"
                                                        IsEnabled="False" Click="ReplayPause_Click"/>
                                                <Button x:Name="ReplayStopBtn" Content="停止" Style="{StaticResource DangerButton}" Padding="18,4" Margin="8,0,0,0"
                                                        IsEnabled="False" Click="ReplayStop_Click"/>
                                                <TextBlock x:Name="ReplayStatusText" Text="未加载" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            </StackPanel>
                                            <ProgressBar x:Name="ReplayProgress" Height="14" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TabBgBrush}" BorderThickness="0"/>
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="“接收区”：把记录按原方向显示在接收区（同时经过协议解析、帧解析、波形等，不触发自动回复）；“主连接发送”：把选中的记录从当前串口/网络发出（常用于把录下的设备输出 RX 重新发给上位机）。速度可在回放中切换。"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- v1.5：批量测试 -->
                                <TabItem Header="批量测试">
                                    <Grid Background="{DynamicResource RxBgBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="120"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="120" MinHeight="60"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                            <WrapPanel>
                                                <TextBlock Text="用例" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="TestNameBox" Width="170" Style="{StaticResource FieldBox}" Margin="0,2,6,2"/>
                                                <Button Content="新建" Style="{StaticResource PanelButton}" Margin="0,2,4,2" Click="TestNew_Click"/>
                                                <Button Content="打开…" Style="{StaticResource PanelButton}" Margin="0,2,4,2" Click="TestOpen_Click"/>
                                                <Button Content="保存…" Style="{StaticResource PanelButton}" Margin="0,2,4,2" Click="TestSave_Click"/>
                                                <Button Content="示例" Style="{StaticResource PanelButton}" Margin="0,2,10,2" Click="TestSample_Click"/>
                                                <Button Content="＋ 步骤" Style="{StaticResource PanelButton}" Margin="0,2,4,2" Click="TestAddStep_Click"/>
                                                <Button Content="删除" Style="{StaticResource PanelButton}" Margin="0,2,4,2" Click="TestRemoveStep_Click"/>
                                                <Button Content="↑" Style="{StaticResource PanelButton}" Margin="0,2,4,2" Click="TestMoveUp_Click"/>
                                                <Button Content="↓" Style="{StaticResource PanelButton}" Margin="0,2,10,2" Click="TestMoveDown_Click"/>
                                                <TextBlock Text="会话" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="TestSessionCombo" Width="120" Height="24" Margin="0,2,6,2"/>
                                                <TextBlock Text="循环" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="TestLoopsBox" Width="50" Style="{StaticResource FieldBox}" Margin="0,2,6,2" Text="1"/>
                                                <Button x:Name="TestRunBtn" Content="运行" Style="{StaticResource AccentButton}" Padding="14,2" Margin="0,2,4,2" Click="TestRun_Click"/>
                                                <Button x:Name="TestStopBtn" Content="停止" Style="{StaticResource DangerButton}" Padding="14,2" Margin="0,2,10,2" IsEnabled="False" Click="TestStop_Click"/>
                                                <Button x:Name="TestHtmlBtn" Content="导出 HTML…" Style="{StaticResource PanelButton}" Margin="0,2,4,2" IsEnabled="False" Click="TestExportHtml_Click"/>
                                                <Button x:Name="TestCsvBtn" Content="导出 CSV…" Style="{StaticResource PanelButton}" Margin="0,2,4,2" IsEnabled="False" Click="TestExportCsv_Click"/>
                                            </WrapPanel>
                                        </Border>
                                        <DataGrid x:Name="TestGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                                                  RowHeaderWidth="0" FontSize="12">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Pass">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                            <Setter Property="Foreground" Value="#14532D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Fail">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="Foreground" Value="#7F1D1D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="32"/>
                                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110"/>
                                                <DataGridTextColumn Header="发送内容" Binding="{Binding Send}" Width="170"/>
                                                <DataGridCheckBoxColumn Header="HEX" Binding="{Binding SendHex, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                                <DataGridComboBoxColumn Header="校验" SelectedItemBinding="{Binding Checksum}" ItemsSource="{x:Static local:TestUiOptions.ChecksumNames}" Width="105"/>
                                                <DataGridComboBoxColumn Header="判定" SelectedItemBinding="{Binding Expect}" ItemsSource="{x:Static local:TestUiOptions.ExpectModes}" Width="100"/>
                                                <DataGridTextColumn Header="期望" Binding="{Binding ExpectValue}" Width="140"/>
                                                <DataGridTextColumn Header="超时ms" Binding="{Binding TimeoutMs}" Width="58"/>
                                                <DataGridTextColumn Header="延时ms" Binding="{Binding DelayMs}" Width="58"/>
                                                <DataGridTextColumn Header="重试" Binding="{Binding Retries}" Width="40"/>
                                                <DataGridCheckBoxColumn Header="失败继续" Binding="{Binding ContinueOnFail, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                                <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" IsReadOnly="True" Width="60"/>
                                                <DataGridTextColumn Header="耗时ms" Binding="{Binding DurationText}" IsReadOnly="True" Width="60"/>
                                                <DataGridTextColumn Header="说明 / 收到" Binding="{Binding Message}" IsReadOnly="True" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>
                                        <Grid Grid.Row="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="TestSummaryText" Margin="10,4" FontWeight="SemiBold" Foreground="{DynamicResource RxFgBrush}"
                                                       Text="判定方式：包含 / 正则 / 精确 HEX（?? 为任意字节）/ Modbus 合法应答 / 不等待。超时、重试、延时以毫秒计。"/>
                                            <TextBox x:Name="TestLogBox" Grid.Row="1" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                     Background="{DynamicResource ScriptOutBgBrush}" Foreground="{DynamicResource ScriptOutFgBrush}"
                                                     BorderThickness="0" Padding="8,4" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Grid>
                                </TabItem>

                                <!-- v1.5：Modbus 网关 -->
                                <TabItem Header="Modbus 网关">
                                    <Grid Background="{DynamicResource RxBgBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource RxHeaderBgBrush}" Padding="10,5">
                                            <WrapPanel>
                                                <TextBlock Text="方向" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="GwModeCombo" Width="250" Height="24" Margin="0,2,10,2" SelectionChanged="GwModeCombo_SelectionChanged"/>
                                                <TextBlock Text="RTU 会话" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="GwSessionCombo" Width="120" Height="24" Margin="0,2,10,2"
                                                          ToolTip="连接 RTU 总线的会话（通常是一个串口会话）"/>
                                                <StackPanel x:Name="GwServerPanel" Orientation="Horizontal">
                                                    <TextBlock Text="TCP 监听端口" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox x:Name="GwPortBox" Width="60" Style="{StaticResource FieldBox}" Margin="0,2,10,2"/>
                                                </StackPanel>
                                                <StackPanel x:Name="GwClientPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                    <TextBlock Text="远端从站" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox x:Name="GwHostBox" Width="120" Style="{StaticResource FieldBox}" Margin="0,2,4,2"/>
                                                    <TextBlock Text=":" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="GwRemotePortBox" Width="60" Style="{StaticResource FieldBox}" Margin="0,2,10,2"/>
                                                </StackPanel>
                                                <TextBlock Text="超时 ms" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="GwTimeoutBox" Width="60" Style="{StaticResource FieldBox}" Margin="0,2,10,2"/>
                                                <TextBlock Text="替换站号" Foreground="{DynamicResource RxHeaderFgBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="GwUnitBox" Width="40" Style="{StaticResource FieldBox}" Margin="0,2,10,2" ToolTip="0 = 不替换，原样转发站号"/>
                                                <Button x:Name="GwStartBtn" Content="启动网关" Style="{StaticResource AccentButton}" Padding="14,2" Margin="0,2,6,2" Click="GwStart_Click"/>
                                                <Button Content="清空日志" Style="{StaticResource PanelButton}" Margin="0,2,6,2" Click="GwClear_Click"/>
                                            </WrapPanel>
                                        </Border>
                                        <TextBlock x:Name="GwStatsText" Grid.Row="1" Margin="10,5" Foreground="{DynamicResource RxFgBrush}" FontFamily="{StaticResource MonoFont}"
                                                   TextWrapping="Wrap" Text="网关未启动。TCP→RTU：本机作为 Modbus TCP 服务器，把请求转成 RTU+CRC 发到所选会话；RTU→TCP：所选会话上的 RTU 主站请求被转发到远端 Modbus TCP 从站。"/>
                                        <ListBox x:Name="GwLogList" Grid.Row="2" Background="{DynamicResource RxBgBrush}" BorderThickness="0" Padding="6,2"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="t" Text="{Binding Text}" Foreground="{DynamicResource RxFgBrush}" TextWrapping="NoWrap"/>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter TargetName="t" Property="Foreground" Value="#F87171"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False" Cursor="SizeNS"/>

                <!-- 发送区 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="编辑快捷指令…" Style="{StaticResource SmallButton}"
                                    VerticalAlignment="Top" Margin="6,0,0,0" Click="EditQuick_Click"/>
                            <TextBlock Text="快捷指令" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,10,0"/>
                            <WrapPanel x:Name="QuickPanel"/>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,2,0,6">
                            <TextBlock Text="发送区" Style="{StaticResource CardTitle}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="历史" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="HistoryCombo" Width="300" Margin="0" SelectionChanged="HistoryCombo_SelectionChanged"
                                      ToolTip="选择一条历史记录填入发送区">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" MaxWidth="520" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource MonoFont}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="清除历史" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="ClearHistory_Click"/>
                            <TextBlock Text="Ctrl+Enter 发送" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SendBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                     Padding="6,4" VerticalContentAlignment="Top"
                                     PreviewKeyDown="SendBox_PreviewKeyDown" TextChanged="SendBox_TextChanged"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button x:Name="SendBtn" Content="发送" Style="{StaticResource AccentButton}" Height="46" FontSize="15"
                                        Click="SendBtn_Click"/>
                                <Button Content="清空发送" Margin="0,6,0,0" Click="ClearSend_Click"/>
                                <Button Content="发送文件…" Margin="0,6,0,0" Click="SendFile_Click"
                                        ToolTip="把文件的原始字节发送出去（最大 16 MB，不追加校验和行尾）"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
            </TabItem>
            <TabItem x:Name="PlusTab" Header="＋" ToolTip="新建会话标签页（每个标签页是一个独立的连接）"/>
        </TabControl>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBgBrush}" Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="RateText" Text="RX: 0 B/s  TX: 0 B/s" Foreground="{DynamicResource StatRateBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" MinWidth="210"/>
                    <TextBlock x:Name="PeakText" Text="峰值 —" Foreground="{DynamicResource StatPeakBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" MinWidth="160"/>
                    <TextBlock x:Name="SessionText" Text="会话 00:00" Foreground="{DynamicResource StatMutedBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" MinWidth="90"/>
                    <TextBlock x:Name="FrameText" Text="" Foreground="{DynamicResource StatFrameBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="AutoReplyCountText" Text="" Foreground="{DynamicResource StatPeakBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="RxCountText" Text="RX: 0" Foreground="{DynamicResource StatRxBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" MinWidth="100"/>
                    <TextBlock x:Name="TxCountText" Text="TX: 0" Foreground="{DynamicResource StatTxBrush}" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="8,0,8,0" MinWidth="100"/>
                    <Button Content="计数清零" Style="{StaticResource PanelButton}" Click="ResetCounters_Click"/>
                </StackPanel>
                <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource StatusFgBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
