<Window x:Class="SerialTool.TriggerRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接收触发规则" Width="980" Height="640" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,10,0">
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="新建" Style="{StaticResource SmallButton}" Click="Add_Click" Margin="0,0,4,4"/>
                <Button Content="复制" Style="{StaticResource SmallButton}" Click="Dup_Click" Margin="0,0,4,4"/>
                <Button Content="删除" Style="{StaticResource SmallButton}" Click="Del_Click" Margin="0,0,4,4"/>
                <Button Content="上移" Style="{StaticResource SmallButton}" Click="Up_Click" Margin="0,0,4,4"/>
                <Button Content="下移" Style="{StaticResource SmallButton}" Click="Down_Click" Margin="0,0,4,4"/>
                <Button Content="命中清零" Style="{StaticResource SmallButton}" Click="ResetHits_Click" Margin="0,0,4,4"/>
            </WrapPanel>
            <ListBox x:Name="RuleList" SelectionChanged="RuleList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EditPanel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,2" TextChanged="Field_Changed"/>
                    <TextBlock Grid.Row="1" Text="匹配内容" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" Margin="0,2" TextChanged="Field_Changed"/>
                    <TextBlock Grid.Row="2" Text="匹配方式" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                        <ComboBox x:Name="KindCombo" Width="110" SelectionChanged="Field_SelChanged" Margin="0,0,10,0"/>
                        <CheckBox x:Name="IgnoreCaseChk" Content="忽略大小写" Click="Field_Click" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="EnabledChk" Content="启用" Click="Field_Click" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="3" Text="冷却 (ms)" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                        <TextBox x:Name="CooldownBox" Width="90" Style="{StaticResource FieldBox}" TextChanged="Field_Changed"/>
                        <TextBlock Text="同一规则两次触发的最短间隔；冷却期内的匹配只计入“被抑制”" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="4" Text="命中" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="HitText" Grid.Row="4" Grid.Column="1" Margin="0,4" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="PatternError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="80,2,0,0"/>

                <TextBlock Text="动作（按顺序执行）" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                <ListBox x:Name="ActionList" Height="140" SelectionChanged="ActionList_SelectionChanged"/>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="删除动作" Style="{StaticResource SmallButton}" Click="DelAction_Click" Margin="0,0,4,0"/>
                    <Button Content="上移" Style="{StaticResource SmallButton}" Click="ActUp_Click" Margin="0,0,4,0"/>
                    <Button Content="下移" Style="{StaticResource SmallButton}" Click="ActDown_Click" Margin="0,0,12,0"/>
                </WrapPanel>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="8">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="动作" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ActKindCombo" Width="170" SelectionChanged="ActKind_Changed" Margin="0,0,10,0"/>
                            <Button Content="添加为新动作" Style="{StaticResource AccentButton}" Click="AddAction_Click" Margin="0,0,6,0"/>
                            <Button Content="更新选中动作" Style="{StaticResource SmallButton}" Click="UpdateAction_Click"/>
                        </WrapPanel>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="参数" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/>
                            <Button x:Name="BrowseBtn" Content="浏览…" Style="{StaticResource SmallButton}" DockPanel.Dock="Right" Click="Browse_Click" Margin="6,0,0,0"/>
                            <TextBox x:Name="ParamBox" Style="{StaticResource FieldBox}"/>
                        </DockPanel>
                        <TextBlock x:Name="ParamHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="测试匹配（不执行动作，只显示会触发哪些规则）" Style="{StaticResource CardTitle}" Margin="0,12,0,4"/>
                <DockPanel>
                    <Button Content="测试" Style="{StaticResource SmallButton}" DockPanel.Dock="Right" Click="Test_Click" Margin="6,0,0,0"/>
                    <CheckBox x:Name="TestHexChk" Content="HEX" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBox x:Name="TestBox" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" Text="+CME ERROR: 10"/>
                </DockPanel>
                <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="确定" Style="{StaticResource AccentButton}" Width="80" Click="Ok_Click" Margin="0,0,6,0" IsDefault="True"/>
                <Button Content="取消" Width="80" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
            <CheckBox x:Name="GlobalChk" Content="启用接收触发（总开关）" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="通知文本可用 {rule} {count} {time} {pattern}。触发规则与「自动回复」相互独立。" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
