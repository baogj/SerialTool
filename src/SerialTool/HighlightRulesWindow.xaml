<Window x:Class="SerialTool.HighlightRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SerialTool"
        Title="关键字高亮 / 自动回复规则" Width="1180" Height="560" MinWidth="860" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <local:ColorTextToBrushConverter x:Key="ColorBrush"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"
                   Text="每行一条规则，按顺序匹配（重叠时前面的优先）。匹配方式：默认文本；勾“正则”按 .NET 正则；勾“HEX”按字节匹配（如 AA 55，HEX 显示时也会高亮）。自动回复：收到匹配内容后延时发送“回复内容”（会追加左侧校验和行尾），同一规则在“冷却”毫秒内不重复触发，全局每秒最多 20 次，防止两台设备互相回复死循环。"/>
        <DataGrid x:Name="RuleGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="启用" Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="匹配内容" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTemplateColumn Header="正则" Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsRegex, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="HEX" Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsHex, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="忽略大小写" Width="74">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="颜色" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,0">
                                <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="3" Margin="0,0,4,0"
                                        BorderBrush="#9CA3AF" BorderThickness="1"
                                        Background="{Binding Color, Converter={StaticResource ColorBrush}}"/>
                                <ComboBox IsEditable="True" Height="24" Margin="0"
                                          ItemsSource="{x:Static local:HighlightRulesWindow.PresetColors}"
                                          Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,6,0"
                                                        Background="{Binding Converter={StaticResource ColorBrush}}"/>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="自动回复" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding ReplyEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="回复内容" Binding="{Binding ReplyContent, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTemplateColumn Header="回复HEX" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding ReplyIsHex, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="延时ms" Binding="{Binding ReplyDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                <DataGridTextColumn Header="冷却ms" Binding="{Binding CooldownMs, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 测试 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="测试文本" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TestBox" Grid.Column="1" Style="{StaticResource FieldBox}" Text="+CSQ: 23,99 ... ERROR ... PING"
                     ToolTip="输入一段示例文本，点“测试”查看哪些规则会命中"/>
            <Button Grid.Column="2" Content="测试" Width="64" Margin="6,0,0,0" Click="Test_Click"/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="确定" Style="{StaticResource AccentButton}" Width="84" IsDefault="True" Click="Ok_Click"/>
                <Button Content="取消" Width="84" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="添加" Width="64" Click="Add_Click"/>
                <Button Content="删除" Width="64" Margin="6,0,0,0" Click="Delete_Click"/>
                <Button Content="上移" Width="64" Margin="6,0,0,0" Click="Up_Click"/>
                <Button Content="下移" Width="64" Margin="6,0,0,0" Click="Down_Click"/>
                <TextBlock x:Name="TestResult" Style="{StaticResource MutedText}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           MaxWidth="560"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
