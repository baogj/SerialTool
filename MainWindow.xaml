<Window x:Class="SerialTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SerialTool 串口调试助手" Width="1280" Height="860" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="app.ico"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="10,10,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧设置面板 ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 串口设置 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="串口设置" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="端口" Style="{StaticResource FieldLabel}"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortCombo" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
                                    <Button x:Name="RefreshBtn" Grid.Column="1" Content="刷新" Style="{StaticResource SmallButton}"
                                            Margin="4,3,0,3" ToolTip="刷新串口列表 (F5)" Click="RefreshBtn_Click"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="波特率" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="BaudCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="可直接输入自定义波特率，回车生效"
                                          SelectionChanged="BaudCombo_SelectionChanged" LostFocus="BaudCombo_LostFocus"
                                          PreviewKeyDown="BaudCombo_PreviewKeyDown"/>

                                <TextBlock Grid.Row="2" Text="数据位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DataBitsCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="PortParam_Changed"/>

                                <TextBlock Grid.Row="3" Text="停止位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="StopBitsCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="PortParam_Changed"/>

                                <TextBlock Grid.Row="4" Text="校验位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ParityCombo" Grid.Row="4" Grid.Column="1" SelectionChanged="PortParam_Changed"/>

                                <TextBlock Grid.Row="5" Text="流控" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="FlowCombo" Grid.Row="5" Grid.Column="1" SelectionChanged="PortParam_Changed"/>
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <CheckBox x:Name="DtrChk" Content="DTR" Click="DtrChk_Click"/>
                                <CheckBox x:Name="RtsChk" Content="RTS" Click="RtsChk_Click"/>
                                <CheckBox x:Name="AutoReconnectChk" Content="自动重连" ToolTip="设备拔出后重新插入时自动打开"/>
                            </UniformGrid>

                            <Button x:Name="OpenBtn" Content="打开串口" Style="{StaticResource AccentButton}" Height="36"
                                    FontSize="14" Margin="0,8,0,0" Click="OpenBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 接收设置 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="接收设置" Style="{StaticResource CardTitle}"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="HexDisplayChk" Content="HEX 显示" Click="RxOption_Click"/>
                                <CheckBox x:Name="TimestampChk" Content="显示时间戳" Click="RxOption_Click"/>
                                <CheckBox x:Name="ShowTxChk" Content="显示发送" Click="RxOption_Click"/>
                                <CheckBox x:Name="AutoScrollChk" Content="自动滚动" Click="AutoScrollChk_Click"/>
                                <CheckBox x:Name="PauseChk" Content="暂停显示" Click="PauseChk_Click"/>
                                <CheckBox x:Name="LogChk" Content="记录到文件" Click="LogChk_Click"
                                          ToolTip="把显示内容实时追加写入日志文件"/>
                            </UniformGrid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="编码" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="EncodingCombo" Grid.Column="1" SelectionChanged="EncodingCombo_SelectionChanged"
                                          ToolTip="接收显示与文本发送使用的字符编码"/>
                                <TextBlock Grid.Row="1" Text="分帧" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="FrameGapBox" Width="70" Style="{StaticResource FieldBox}" LostFocus="FrameGapBox_LostFocus"
                                             ToolTip="开启时间戳/显示发送时，两次数据间隔超过该值则另起一行"/>
                                    <TextBlock Text="ms（时间戳分行间隔）" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="协议" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ProtocolCombo" Grid.Row="2" Grid.Column="1"
                                          ToolTip="普通：原样显示；AT：命令/回显着色；Modbus RTU：帧解析+CRC"
                                          SelectionChanged="ProtocolCombo_SelectionChanged"/>
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Content="清空接收" Margin="0,0,4,0" Click="ClearRx_Click"/>
                                <Button Content="保存接收…" Margin="4,0,0,0" Click="SaveRx_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 发送设置 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="发送设置" Style="{StaticResource CardTitle}"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="HexSendChk" Content="HEX 发送" Click="HexSendChk_Click"/>
                                <CheckBox x:Name="EscapeChk" Content="解析转义符" ToolTip="文本模式下支持 \r \n \t \0 \\ \xHH"/>
                            </UniformGrid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="行尾" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LineEndingCombo" Grid.Column="1" ToolTip="每次发送时自动追加的结尾字符"/>
                                <CheckBox x:Name="TimedChk" Grid.Row="1" Content="定时" Click="TimedChk_Click" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="IntervalBox" Width="70" Style="{StaticResource FieldBox}" LostFocus="IntervalBox_LostFocus"/>
                                    <TextBlock Text="ms 周期发送发送区内容" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 右侧收发区 ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="SendRow" Height="250" MinHeight="170"/>
                </Grid.RowDefinitions>

                <!-- 接收 / 波形 / 脚本 -->
                <Border Style="{StaticResource Card}" Margin="0" Padding="0" Background="#1E1E1E" BorderBrush="#2D2D2D">
                    <TabControl x:Name="MainTabs" Background="#1E1E1E" BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                <Setter Property="Padding" Value="12,4"/>
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="4,4,0,0">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- 接收 -->
                        <TabItem Header="接收">
                            <Grid Background="#1E1E1E">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#252526" Padding="12,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border x:Name="PausedBadge" Background="#F59E0B" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="已暂停" Foreground="Black" FontSize="12"/>
                                            </Border>
                                            <Border x:Name="LogBadge" Background="#10B981" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock Text="记录中" Foreground="Black" FontSize="12"/>
                                            </Border>
                                            <TextBlock x:Name="ProtocolHint" Text="" Foreground="#9CA3AF" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="清空" Style="{StaticResource SmallButton}" Background="#3A3D41" Foreground="#E5E7EB"
                                                    BorderBrush="#4B5563" Click="ClearRx_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="接收区" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <!-- 普通：TextBox；协议：ListBox -->
                                <TextBox x:Name="RxBox" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0" Padding="8,6"
                                         FontFamily="{StaticResource MonoFont}" FontSize="13"
                                         TextWrapping="Wrap" AcceptsReturn="True" IsUndoEnabled="False" UndoLimit="0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         VerticalContentAlignment="Top" SelectionBrush="#264F78"/>
                                <ListBox x:Name="ProtocolList" Grid.Row="1" Visibility="Collapsed"
                                         Background="#1E1E1E" BorderThickness="0" Padding="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#D4D4D4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- 波形 -->
                        <TabItem Header="波形">
                            <Grid Background="#111827">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#1F2937" Padding="10,6">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <CheckBox x:Name="WaveShowTxChk" Content="显示 TX" Foreground="#E5E7EB" Margin="0,0,12,0"
                                                      Click="WaveOption_Click"/>
                                            <CheckBox x:Name="WavePauseChk" Content="暂停" Foreground="#E5E7EB" Margin="0,0,12,0"
                                                      Click="WavePause_Click"/>
                                            <TextBlock Text="窗口" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="WaveWindowCombo" Width="90" Height="26" SelectionChanged="WaveWindow_Changed"/>
                                            <Button Content="清空波形" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                                    Background="#374151" Foreground="#E5E7EB" BorderBrush="#4B5563"
                                                    Click="WaveClear_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="字节流波形（Y=0..255）" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="WaveHost" Grid.Row="1" Background="#111827"/>
                            </Grid>
                        </TabItem>

                        <!-- 脚本 -->
                        <TabItem Header="脚本">
                            <Grid Background="#1E1E1E">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="120"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="140" MinHeight="80"/>
                                </Grid.RowDefinitions>
                                <Border Background="#252526" Padding="10,6">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="AT 示例" Style="{StaticResource SmallButton}" Background="#3A3D41" Foreground="#E5E7EB"
                                                    BorderBrush="#4B5563" Margin="0,0,6,0" Click="ScriptSampleAt_Click"/>
                                            <Button Content="Modbus 示例" Style="{StaticResource SmallButton}" Background="#3A3D41" Foreground="#E5E7EB"
                                                    BorderBrush="#4B5563" Margin="0,0,6,0" Click="ScriptSampleModbus_Click"/>
                                            <Button x:Name="ScriptRunBtn" Content="运行" Style="{StaticResource AccentButton}" Padding="14,2"
                                                    Margin="0,0,6,0" Click="ScriptRun_Click"/>
                                            <Button x:Name="ScriptStopBtn" Content="停止" Style="{StaticResource DangerButton}" Padding="14,2"
                                                    IsEnabled="False" Click="ScriptStop_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="自动化脚本（SEND / SENDHEX / SLEEP / WAITFOR / LOG）"
                                                   Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <TextBox x:Name="ScriptBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                         Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0" Padding="8"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#374151"/>
                                <TextBox x:Name="ScriptOutBox" Grid.Row="3" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Background="#0B1220" Foreground="#93C5FD" BorderThickness="0" Padding="8"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False" Cursor="SizeNS"/>

                <!-- 发送区 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="编辑快捷指令…" Style="{StaticResource SmallButton}"
                                    VerticalAlignment="Top" Margin="6,0,0,0" Click="EditQuick_Click"/>
                            <TextBlock Text="快捷指令" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,10,0"/>
                            <WrapPanel x:Name="QuickPanel"/>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,2,0,6">
                            <TextBlock Text="发送区" Style="{StaticResource CardTitle}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="历史" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="HistoryCombo" Width="300" Margin="0" SelectionChanged="HistoryCombo_SelectionChanged"
                                      ToolTip="选择一条历史记录填入发送区">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" MaxWidth="520" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource MonoFont}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="清除历史" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="ClearHistory_Click"/>
                            <TextBlock Text="Ctrl+Enter 发送" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SendBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                     Padding="6,4" VerticalContentAlignment="Top" BorderBrush="#D1D5DB"
                                     PreviewKeyDown="SendBox_PreviewKeyDown"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button x:Name="SendBtn" Content="发送" Style="{StaticResource AccentButton}" Height="46" FontSize="15"
                                        Click="SendBtn_Click"/>
                                <Button Content="清空发送" Margin="0,6,0,0" Click="ClearSend_Click"/>
                                <Button Content="发送文件…" Margin="0,6,0,0" Click="SendFile_Click"
                                        ToolTip="把文件的原始字节发送出去（最大 16 MB）"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="1" Background="#1F2937" Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="RateText" Text="RX: 0 B/s  TX: 0 B/s" Foreground="#FCD34D" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" MinWidth="210"/>
                    <TextBlock x:Name="PeakText" Text="峰值 —" Foreground="#A78BFA" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" MinWidth="160"/>
                    <TextBlock x:Name="SessionText" Text="会话 00:00" Foreground="#9CA3AF" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" MinWidth="90"/>
                    <TextBlock x:Name="FrameText" Text="" Foreground="#F9A8D4" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="RxCountText" Text="RX: 0" Foreground="#93C5FD" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="0,0,0,0" MinWidth="100"/>
                    <TextBlock x:Name="TxCountText" Text="TX: 0" Foreground="#86EFAC" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" Margin="8,0,8,0" MinWidth="100"/>
                    <Button Content="计数清零" Style="{StaticResource SmallButton}" Background="#374151" Foreground="#E5E7EB"
                            BorderBrush="#4B5563" Click="ResetCounters_Click"/>
                </StackPanel>
                <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#E5E7EB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
